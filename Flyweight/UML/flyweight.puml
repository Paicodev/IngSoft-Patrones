@startuml
skinparam classAttributeIconSize 0

class TipoArbol {
    -nombre : String
    +dibujar(x : int, y : int) : void
}

class FabricaArboles {
    -tipos : Map<String, TipoArbol>
    +obtener(nombre : String) : TipoArbol
}

class flyweight {
    +{static} main(args : String[]) : void
}

FabricaArboles o--> "*" TipoArbol : comparte por nombre
flyweight ..> FabricaArboles : obtiene tipos
flyweight ..> TipoArbol : pasa coordenadas

@enduml
